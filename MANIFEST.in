# What an sdist must carry so that `pip install flexkv` can compile from source.
#
# setup.py builds flexkv.c_ext from csrc/ and links it against libxxhash, which
# CMakeLists.txt builds out of the vendored third_party/xxHash. Both the C++
# sources and the vendored dependencies therefore have to ship: they are the
# build inputs, not optional extras.
include CMakeLists.txt
include LICENSE
include README.md
include README_zh.md
include requirements.txt
include pyproject.toml

# Generated by setup.py and gitignored, but it must ship: an unpacked sdist has
# no .git, so this file is the only way the build knows its own version.
include flexkv/_version.py

# C++/CUDA sources for flexkv.c_ext.
graft csrc

# Vendored xxHash: CMakeLists globs third_party/xxHash/*.h and compiles
# third_party/xxHash/xxhash.c. Nothing below that needs to ship, and its
# tests/ alone is 4.7MB.
include third_party/xxHash/*.c
include third_party/xxHash/*.h
include third_party/xxHash/LICENSE

# Vendored spdlog: header-only, consumed via third_party/spdlog/include.
graft third_party/spdlog/include
include third_party/spdlog/LICENSE

# prometheus-cpp is deliberately absent. Monitoring is opt-in
# (FLEXKV_ENABLE_METRICS=1) and CMakeLists already degrades to
# FLEXKV_ENABLE_MONITORING=OFF when the directory is missing, so shipping it
# would cost every user megabytes for a default-off feature. Building with
# metrics requires a git clone with submodules.
prune third_party/prometheus-cpp

# Not build inputs.
prune tests
prune benchmarks
prune examples
prune docs
prune monitoring
prune scripts
prune .github
prune build
prune dist
exclude .gitmodules
exclude run_tests.sh
global-exclude *.so *.so.* *.pyc *.pyo __pycache__/* .git*
