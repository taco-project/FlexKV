-# PP-channel command tags (used by ``scatter_pp`` payloads). Sender and
-# receiver assert on these to catch protocol drift early.
-CMD_PUT_META = 2
-CMD_LAYERWISE = 3
-CMD_STORE_COMPLETE = 5
